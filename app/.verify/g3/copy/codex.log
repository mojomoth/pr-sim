        {GROUPS.map((g) => {
          const list = steps.filter((x) => x.group === g.id);
          if (!list.length) return null;
          return (
            <section key={g.id} className="rounded-[20px] bg-surface p-4">
              <h3 className="text-[15px] font-semibold text-secondary">{g.label}</h3>
              <ul className="mt-2 flex flex-col gap-2">
                {list.map((x) => (
                  <li key={x.id} className="grid grid-cols-[22px_minmax(0,1fr)_auto] items-start gap-2" data-status={x.status}>
                    <span className="mt-0.5">
                      {x.status === "running" ? (
                        <Spinner />
                      ) : x.status === "done" || x.status === "skipped" ? (
                        <span className="inline-flex h-[18px] w-[18px] items-center justify-center rounded-full bg-ink text-inverse">
                          <Check size={12} strokeWidth={3} />
                        </span>
                      ) : x.status === "error" ? (
                        <span className="inline-flex h-[18px] w-[18px] items-center justify-center text-[15px] font-bold text-error">!</span>
                      ) : (
                        <span className="block h-[18px] w-[18px] rounded-full border-2 border-line" />
                      )}
                    </span>
                    <span className="min-w-0">
                      <span className={`block text-[15px] leading-[22px] ${x.status === "pending" ? "text-secondary" : ""}`}>{x.label}</span>
                      {x.detail && <span className={`block text-[13px] leading-5 ${x.status === "error" ? "text-error" : "text-secondary"}`}>{x.detail}</span>}
                    </span>
                    <span className="sr-only">{STATUS_KO[x.status]}</span>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      {stale && (
        <button type="button" onClick={onGenerate} className="mt-1 inline-flex min-h-11 items-center gap-1.5 text-[14px] font-medium text-secondary underline underline-offset-4 hover:text-ink">
          {j.imageKey ? "이 성향으로 새 심사위원 만들기" : "얼굴 만들기"}
        </button>
      )}
    </JudgeRow>
  );
}

function WikiStatus({ sid, doc }: { sid: string; doc: StoredDoc }) {
  const progress = wikiProgress(sid, doc);
  const empty = doc.emptyPages.length;
  const emptyNote =
    empty > 0 && `글자가 없는 ${doc.emptyPages.slice(0, 5).join(", ")}쪽${empty > 5 ? ` 외 ${empty - 5}개 쪽` : ""}은 분석에서 빠져요.`;
  if (doc.wikiState === "error")
    return (
      <div className="flex items-center gap-2 rounded-[16px] border border-error/40 py-1.5 pl-4 pr-1.5" role="alert">
        <Alert size={18} className="shrink-0 text-error" />
        <p className="min-w-0 flex-1 text-[13px] leading-[18px]">
          <span className="font-semibold text-error">자료 분석 실패</span>
          <span className="text-secondary"> · {doc.wikiError ?? "다시 시도해 주세요."}</span>
        </p>
        <button type="button" onClick={() => void buildWiki(sid, doc)} className="inline-flex h-11 shrink-0 items-center gap-1.5 rounded-full bg-surface px-3.5 text-[14px] font-semibold">
          <Refresh size={16} /> 다시 시도
        </button>
      </div>
    );
  if (doc.wikiState === "ready")
    return (
      <p className="px-1 text-[13px] leading-[18px] text-secondary">
        자료 분석을 마쳤어요. 심사위원이 이 자료를 근거로 질문해요.{emptyNote && ` ${emptyNote}`}
      </p>
    );
  const pct = progress && progress.total > 0 ? Math.round((progress.done / progress.total) * 100) : 0;
  return (
    <div className="flex flex-col gap-1.5 px-1" role="status">
      <div className="flex items-center justify-between gap-3 text-[13px] leading-[18px] text-secondary">
        <span>질문에 쓸 자료를 분석하고 있어요. 기다리지 않고 발표를 시작해도 돼요.</span>
        <span className="shrink-0 tabular">{pct}%</span>
      </div>
      <div className="h-1 overflow-hidden rounded-full bg-line" aria-hidden="true">
